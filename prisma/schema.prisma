generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ShipmentStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  AT_EXCHANGE_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum BookingType {
  FLIGHT
  HOTEL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TxType {
  CREDIT
  DEBIT
}

enum TxSource {
  POINT_PURCHASE
  POINT_DEDUCTION
  REFUND
  ADJUSTMENT
  REWARD
}

enum InvoiceStatus {
  DRAFT
  PAID
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  passwordHash String
  wallet       Decimal    @default(0) @db.Decimal(12, 2)
  points       Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shipments     Shipment[]
  bookings      Booking[]
  invoices      Invoice[]
  transactions  Transaction[]
  tickets       Ticket[]
  notifications Notification[]
  ticketMessages TicketMessage[]
}

model Shipment {
  id             String         @id @default(cuid())
  trackingNumber String         @unique
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id])
  origin         String
  destination    String
  description    String?
  weightKg       Decimal        @db.Decimal(8, 2)
  status         ShipmentStatus @default(PENDING)
  cost           Decimal        @db.Decimal(10, 2)
  pointsUsed     Int
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events   ShipmentEvent[]
  invoices Invoice[]
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String?
  note       String?
  createdAt  DateTime @default(now())
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  type      BookingType
  status    BookingStatus @default(CONFIRMED)
  ref       String        @unique
  cost      Decimal       @db.Decimal(10, 2)
  details   Json
  createdAt DateTime      @default(now())

  invoices Invoice[]
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  shipmentId String?
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id])
  bookingId  String?
  booking    Booking?      @relation(fields: [bookingId], references: [id])
  status     InvoiceStatus @default(PAID)
  subtotal   Decimal       @db.Decimal(10, 2)
  tax        Decimal       @default(0) @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  items    InvoiceItem[]
  receipts Receipt[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String
  qty       Int     @default(1)
  price     Decimal @db.Decimal(10, 2)
}

model Receipt {
  id        String   @id @default(cuid())
  number    String   @unique
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  method    String   @default("WALLET")
  createdAt DateTime @default(now())
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         TxType
  source       TxSource
  amount       Decimal  @db.Decimal(10, 2)
  points       Int      @default(0)
  balanceAfter Decimal  @db.Decimal(10, 2)
  description  String?
  refId        String?
  createdAt    DateTime @default(now())
}

model Ticket {
  id          String         @id @default(cuid())
  number      String         @unique
  requesterId String
  requester   User           @relation(fields: [requesterId], references: [id])
  subject     String
  category    String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
